# Organisers' GET link from page 3 of the guide (the "Открыть GET для DEV" button).
# group_id is added by the app, so it can be left in or removed.
CQA_API_URL=
# Gemini API key from https://aistudio.google.com (free tier). NOT the Gemini Plus subscription.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Paid-tier price per 1M tokens (USD) for the cost estimate shown in the UI.
# gemini-3.5-flash standard tier: $1.50 input / $9.00 output (check ai.google.dev/gemini-api/docs/pricing).
# On the free tier the real cost is $0; these numbers show what it would cost in production.
LLM_PRICE_IN=1.50
LLM_PRICE_OUT=9.00
# Independent model runs per dialogue, combined by majority vote (1 = fastest; 3 recommended for the control set).
EVAL_RUNS=3
# Optional: minimum ms between model calls in a batch (free-tier requests-per-minute limits).
LLM_MIN_INTERVAL_MS=
PORT=8080
# Team name written into results/*/results.json
TEAM_NAME=
